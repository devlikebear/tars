{
  "name": "TARS Console",
  "short_name": "TARS",
  "description": "TARS local agent control console — chat, memory, ops, pulse, reflection.",
  "id": "/console/",
  "start_url": "/console/",
  "scope": "/console/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#141414",
  "theme_color": "#141414",
  "lang": "en",
  "categories": ["productivity", "developer", "utilities"],
  "icons": [
    {
      "src": "pwa-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "pwa-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "pwa-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "pwa-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
