{
  "name": "TARS Console",
  "short_name": "TARS",
  "description": "TARS local agent control console — chat, memory, ops, pulse, reflection.",
  "id": "/console/",
  "start_url": "/console/",
  "scope": "/console/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#141414",
  "theme_color": "#141414",
  "lang": "en",
  "categories": ["productivity", "developer", "utilities"],
  "icons": [
    {
      "src": "pwa-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "pwa-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "pwa-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "pwa-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Chat",
      "short_name": "Chat",
      "description": "Jump to the active chat session.",
      "url": "/console/chat",
      "icons": [{ "src": "pwa-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Sessions",
      "short_name": "Sessions",
      "description": "Browse all chat sessions and lineage.",
      "url": "/console/sessions",
      "icons": [{ "src": "pwa-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Ops",
      "short_name": "Ops",
      "description": "System health, approvals, and cleanup.",
      "url": "/console/ops",
      "icons": [{ "src": "pwa-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Pulse",
      "short_name": "Pulse",
      "description": "Watchdog status, ticks, and alerts.",
      "url": "/console/pulse",
      "icons": [{ "src": "pwa-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Reflection",
      "short_name": "Reflection",
      "description": "Nightly reflection runs and experience extraction.",
      "url": "/console/reflection",
      "icons": [{ "src": "pwa-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
